load("@rules_android//android:rules.bzl", "android_library")
load("@rules_java//java:defs.bzl", "java_plugin")
load("//kotlin:android.bzl", "kt_android_library")
load("//kotlin:core.bzl", "kt_ksp_plugin")
load("//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_import", "kt_jvm_library", "kt_jvm_test")

# Fixture matrix captured by the aquery-diff gate (//src/main/starlark/core/pipeline/tools).
# Each kt_jvm_* rule appears in {plain, kapt, ksp} where applicable; kt_jvm_import
# is plain-only. The android target is tagged "manual" so the //src/... presubmit
# wildcard skips it (it needs the android SDK) and is built by explicit label as
# the criterion-4 (android + JVM share one compile engine) oracle.
package(default_visibility = ["//visibility:private"])

# --- annotation processors reused for the kapt/ksp variants ---------------

# KAPT (Java annotation) processor: AutoValue. No @AutoValue symbol exists in the
# trivial sources, so processing is a no-op and the target compiles green while
# still exercising the kapt action path.
java_plugin(
    name = "autovalue_plugin",
    generates_api = 1,
    processor_class = "com.google.auto.value.processor.AutoValueProcessor",
    deps = ["@kotlin_rules_maven//:com_google_auto_value_auto_value"],
)

# KSP processor: Moshi codegen. No @JsonClass symbol exists, so processing is a
# no-op and the target compiles green while still exercising the ksp action path.
kt_ksp_plugin(
    name = "moshi_plugin",
    processor_class = "com.squareup.moshi.kotlin.codegen.ksp.JsonClassSymbolProcessorProvider",
    deps = [
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin",
        "@kotlin_rules_maven_test//:com_squareup_moshi_moshi_kotlin_codegen",
    ],
)

# --- kt_jvm_library x {plain, kapt, ksp} ----------------------------------

kt_jvm_library(
    name = "kt_jvm_library_plain",
    srcs = ["Lib.kt"],
)

kt_jvm_library(
    name = "kt_jvm_library_kapt",
    srcs = ["Lib.kt"],
    plugins = [":autovalue_plugin"],
)

kt_jvm_library(
    name = "kt_jvm_library_ksp",
    srcs = ["Lib.kt"],
    plugins = [":moshi_plugin"],
)

# --- kt_jvm_binary x {plain, kapt, ksp} -----------------------------------

kt_jvm_binary(
    name = "kt_jvm_binary_plain",
    srcs = [
        "Lib.kt",
        "Main.kt",
    ],
    main_class = "fixtures.MainKt",
)

kt_jvm_binary(
    name = "kt_jvm_binary_kapt",
    srcs = [
        "Lib.kt",
        "Main.kt",
    ],
    main_class = "fixtures.MainKt",
    plugins = [":autovalue_plugin"],
)

kt_jvm_binary(
    name = "kt_jvm_binary_ksp",
    srcs = [
        "Lib.kt",
        "Main.kt",
    ],
    main_class = "fixtures.MainKt",
    plugins = [":moshi_plugin"],
)

# --- kt_jvm_junit_test x {plain, kapt, ksp} -------------------------------
# Built (not run) by the gate; test_class need not carry @Test methods to compile.
# Tagged "manual" so the //src/... presubmit wildcard skips RUNNING them (the
# shared Lib.kt has no @Test methods, so JUnit would fail "No runnable methods").
# They still compile under `bazel build //src/...` and by explicit label, which is
# all the aquery gate needs.

kt_jvm_test(
    name = "kt_jvm_junit_test_plain",
    srcs = ["Lib.kt"],
    tags = ["manual"],
    test_class = "fixtures.Lib",
    deps = ["@kotlin_rules_maven_test//:junit_junit"],
)

kt_jvm_test(
    name = "kt_jvm_junit_test_kapt",
    srcs = ["Lib.kt"],
    plugins = [":autovalue_plugin"],
    tags = ["manual"],
    test_class = "fixtures.Lib",
    deps = ["@kotlin_rules_maven_test//:junit_junit"],
)

kt_jvm_test(
    name = "kt_jvm_junit_test_ksp",
    srcs = ["Lib.kt"],
    plugins = [":moshi_plugin"],
    tags = ["manual"],
    test_class = "fixtures.Lib",
    deps = ["@kotlin_rules_maven_test//:junit_junit"],
)

# --- kt_jvm_import (plain only) -------------------------------------------

kt_jvm_import(
    name = "kt_jvm_import_plain",
    jars = [":kt_jvm_library_plain.jar"],
)

# --- kt_android_library (manual; criterion-4 oracle) ----------------------

kt_android_library(
    name = "kt_android_library_fixture",
    srcs = ["Lib.kt"],
    custom_package = "fixtures.android",
    manifest = "AndroidManifest.xml",
    tags = ["manual"],
)
